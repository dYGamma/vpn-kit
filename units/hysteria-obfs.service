[Unit]
Description=Hysteria2 с обфускацией (второй вход, отдельно от основного)
After=network-online.target hysteria-auth.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/hysteria server -c /etc/hysteria/config-obfs.yaml
Restart=on-failure
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
